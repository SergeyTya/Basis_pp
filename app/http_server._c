struct http_state
{
    size_t file_offset; // текущая позиция в отправке
    size_t content_len;
    size_t html_len;

    size_t dyn_data_ofst; 

    uint16_t adr_cnt;
    uint8_t done;

    size_t total_records;


    char buff[HTTP_BUFF_SIZE];
};

bool acp = 0;

static void http_state_free(struct http_state *hs)
{
    if (hs != NULL)
    {
        mem_free(hs);
    }
}

static err_t http_recv(void *arg, struct tcp_pcb *tpcb, struct pbuf *p, err_t err);
extern const char *html_head;
extern const char *html_body;

bool http_check_send_buffer(struct tcp_pcb *pcb, size_t len_requested)
{
    uint16_t http_sent_mss = tcp_mss(pcb);
    size_t len_obtained = LWIP_MIN(tcp_sndbuf(pcb), LWIP_MIN(http_sent_mss, len_requested));
    return len_obtained >= len_requested;
}

err_t http_connection_close(void *arg, struct tcp_pcb *pcb, u16_t len)
{

    struct http_state *hs = (struct http_state *)arg;
    tcp_abort(pcb);
    // tcp_sent(pcb, NULL);
    // tcp_recv(pcb, NULL);

    http_state_free(hs);
    acp = 0;

    return ERR_OK;
}

err_t http_sent_end(void *arg, struct tcp_pcb *pcb, u16_t len)
{
    //  struct http_state *hs = (struct http_state *)arg;
    size_t szo = strlen(html_end);

    if (http_check_send_buffer(pcb, szo))
    {
        //  tcp_sent(pcb, http_connection_close);
        tcp_write(pcb, html_end, szo, TCP_WRITE_FLAG_COPY);
        tcp_sent(pcb, http_connection_close);
    }
    return ERR_OK;
}


err_t http_sent_check_total(void *arg, struct tcp_pcb *pcb, u16_t len)
{
    struct http_state *hs = (struct http_state *)arg;

    size_t req_ln = hs->html_len+1;
    
    if( hs->content_len < req_ln){

        size_t szo = req_ln -  hs->content_len; 
        if(szo > HTTP_BUFF_SIZE) szo = HTTP_BUFF_SIZE;


        if (http_check_send_buffer(pcb, szo))
        {
            memset   (hs->buff, 0x0, HTTP_BUFF_SIZE);
            tcp_write(pcb, hs->buff, szo, TCP_WRITE_FLAG_COPY);
             tcp_sent(pcb, http_sent_check_total);
            hs->content_len += szo;
        }

    }else{
        http_sent_end(arg, pcb, 0);
    }

    return ERR_OK;
}

extern uint8_t GD25_ID[16];
extern uint8_t GD25_RDID[3];




err_t http_sent_html_body(void *arg, struct tcp_pcb *pcb, u16_t len)
{
    struct http_state *hs = (struct http_state *)arg;
    char *http_dyndata = hs->buff;

    u16_t http_sent_mss;
    u16_t http_sent_len;
    err_t err = ERR_OK;

    if (hs == NULL)
        return ERR_ARG;

    if(!http_check_send_buffer(pcb, HTTP_BUFF_SIZE)) return ERR_OK;


    
    while (hs->done != 1)
    {
        /* code */

        // size_t content_sz = HTTP_BUFF_SIZE;

        

        if (hs->file_offset == 0)
        {

            
            memset(hs->buff, 0, HTTP_BUFF_SIZE);
            hs->dyn_data_ofst = 0;

            while (1)
            {
                // здесь формируем заданное количество строк пакуем их в HTTP буфер, когда он заполнился отправляем, после если адо еще раз
                uint32_t ml = hs->total_records; 
                if (hs->adr_cnt >= ml) // условие выхода
                {
                    hs->done = 1;
                    break;
                }

                size_t remaining = HTTP_BUFF_SIZE -  hs->dyn_data_ofst ;
                if (remaining == 0){
                    break; // buffer full need to send
                }

                Typedef_LoggerRecord tmp_rc;
                vTask_logger_read(&tmp_rc , hs->adr_cnt );
                    
                int n = snprintf(&http_dyndata[ hs->dyn_data_ofst ],remaining, tbl
                , hs->adr_cnt  //Номер записи
                , tmp_rc.timeStart.timestamp_day,tmp_rc.timeStart.timestamp_month,tmp_rc.timeStart.timestamp_year//Дата  dd.mm.yy
                , tmp_rc.timeStart.timestamp_hour,tmp_rc.timeStart.timestamp_minute//Время начала сессии
                , tmp_rc.timeStop.timestamp_hour,tmp_rc.timeStop.timestamp_minute//Время начала сессии
                , tmp_rc.type//Тип источника 
                , tmp_rc.LiveCounter //Код ошибки
                , tmp_rc.I //Ток
                , tmp_rc.U //Напряжение
                , tmp_rc.F //Частота
            );
               

                if (n < 0)
                    break;
                if ((size_t)n >= remaining)
                { /* truncated */
                    memset(&http_dyndata[ hs->dyn_data_ofst ], 0 , HTTP_BUFF_SIZE -  hs->dyn_data_ofst );
                    hs->dyn_data_ofst  = HTTP_BUFF_SIZE - 1;
                    http_dyndata[ hs->dyn_data_ofst ] = '\0';
                    break;
                }
                hs->adr_cnt++;
                 hs->dyn_data_ofst  += (size_t)n;
            }

            if (hs->dyn_data_ofst  < HTTP_BUFF_SIZE)
                http_dyndata[ hs->dyn_data_ofst ] = '\0';

             hs->dyn_data_ofst += 1; // dyn data size;
        }

       

        while (hs->file_offset < HTTP_BUFF_SIZE - 1)
        {
            //MSS (Maximum Segment Size) 
            http_sent_mss = tcp_mss(pcb);
            //Свободное место в буфере hs->buff
            int csz = HTTP_BUFF_SIZE - hs->file_offset;
            http_sent_len = LWIP_MIN(tcp_sndbuf(pcb), LWIP_MIN(http_sent_mss, csz));

            // провер
    
            http_sent_len = LWIP_MIN(http_sent_len, hs->dyn_data_ofst);
            

            if (http_sent_len > csz)
            {
                // Буфер полон — выходим, будем ждать следующего вызова
                return ERR_OK;
            }

            err = tcp_write(pcb, &http_dyndata[hs->file_offset], http_sent_len, TCP_WRITE_FLAG_COPY);
            if (err == ERR_OK)
            {
                hs->file_offset += http_sent_len;
                hs->content_len += http_sent_len;
                hs->dyn_data_ofst -= http_sent_len;
                return ERR_OK;
            }
            else if (err == ERR_MEM)
            {
                // Недостаточно памяти — выходим, ждём освобождения
                return ERR_OK;
            }
            else
            {
                return err;
            }
        }

        hs->file_offset = 0;
      
    }
    
   
    http_sent_check_total(arg, pcb, 0);

    return ERR_OK;
}


// Cread header with memory chip ID
static size_t http_create_header(char * buff, size_t buff_sz, struct http_state *hs)
{
    #define SPN_CHECK { if (n > 0 && n < remaining) offset += n; else offset = buff_sz - 1; }
    #define SPN_GET_REMSZ  remaining = buff_sz - offset;

    size_t offset = 0;
    size_t remaining;

    SPN_GET_REMSZ;
    size_t n = snprintf(&buff[offset], remaining, html_start);
    SPN_CHECK;

    SPN_GET_REMSZ;
    n = snprintf(&buff[offset], remaining, "<p>FRDID:%02x-%02x-%02x ", GD25_RDID[0], GD25_RDID[1], GD25_RDID[2]);
    SPN_CHECK;

  
    SPN_GET_REMSZ;
    n = snprintf(&buff[offset], remaining, " FID:%02x", GD25_ID[0]);
    SPN_CHECK;
    

    for (size_t i = 0; i < 15 && offset <  buff_sz - 8; i++)
    {
        SPN_GET_REMSZ;
        n = snprintf(&buff[offset], remaining, "-%02x", GD25_ID[i + 1]);
        SPN_CHECK;
    }

    SPN_GET_REMSZ;
    n = snprintf(&buff[offset], remaining, " DID:%s HASH:%s CRC:%08x <p>", DEVICE_INFO,  HASH_INFO, 0);
    SPN_CHECK;

    SPN_GET_REMSZ;
//n = snprintf(&buff[offset], remaining, "%s", html_head);
    char buf[strlen(html_head)];
    snprintf(buf,remaining, html_head, hs->total_records);
    n = snprintf(&buff[offset], remaining, "%s", buf);
    SPN_CHECK;
    



    return offset;
}

static err_t http_sent_header(void *arg, struct tcp_pcb *pcb, u16_t len)
{

    if (http_check_send_buffer(pcb, 1400))
    {   
        struct http_state *hs = (struct http_state *)arg;

        char * head_pntr = &hs->buff[10];
        size_t len_sz = 10;
        size_t head_sz = sizeof(hs->buff)-len_sz;
        size_t reg_total = 0;
         
        // header
        
         hs->total_records = vTask_logger_get_count();
        size_t offset = http_create_header(head_pntr, head_sz, hs);


        reg_total = hs->total_records;

        hs->content_len = offset + strlen(html_end) ;
        hs->html_len =  reg_total*400/*strlen(tbl)*/ +  hs->content_len; 

        snprintf(hs->buff, len_sz, "%4d", hs->html_len);

        tcp_write(pcb, hd, strlen(hd), TCP_WRITE_FLAG_COPY);
        //len
        tcp_write(pcb, hs->buff, len_sz, TCP_WRITE_FLAG_COPY);
        // http head end
        tcp_write(pcb, hd_end, strlen(hd_end), TCP_WRITE_FLAG_COPY);
        // html head
        tcp_write(pcb, head_pntr, offset, TCP_WRITE_FLAG_COPY);
        tcp_output(pcb);


        tcp_sent(pcb, http_sent_html_body);
    }

    return ERR_OK;
}



/**
 * @brief Callback for receiving HTTP requests
 */
static err_t http_recv(void *arg, struct tcp_pcb *pcb, struct pbuf *p, err_t err)
{
    struct http_state *hs = (struct http_state *)arg;

    if (hs == NULL)
        return ERR_ARG;

    // Инициализируем
    hs->file_offset = 0;
    hs->content_len = 0;
    memset   (hs->buff, 0, HTTP_BUFF_SIZE);
   // logger_adr_rx = logger.adr_cnt;

    if (p == NULL)
    {
        // Соединение закрыто клиентом
        tcp_sent(pcb, NULL);
        http_state_free(hs);
        tcp_close(pcb);
        return ERR_OK;
    }

    // Освобождаем полученные данные (нам не нужно их читать)
    pbuf_free(p);

    hs->adr_cnt = 0;

    tcp_sent(pcb, http_sent_header);
    http_sent_header(arg, pcb, 0);

    return ERR_OK;
}


/**
 * @brief Callback for handling incoming TCP connections
 */
static err_t http_accept(void *arg, struct tcp_pcb *new_pcb, err_t err)
{
    struct http_state *hs;
   
    if (err != ERR_OK || new_pcb == NULL )//|| acp == 1)
    {
        return ERR_VAL;
    }

    acp = 1;
    

    // Выделяем состояние для соединения
    hs = (struct http_state *)mem_malloc(sizeof(struct http_state));

    if (hs == NULL)
    {
        tcp_abort(new_pcb);
        return ERR_MEM;
    }

    hs->file_offset = 0;
    hs->content_len = 0;
    hs->done        = 0;
    
    // Настраиваем соединение
    tcp_arg(new_pcb , hs       );
    tcp_recv(new_pcb, http_recv);
    tcp_err(new_pcb , NULL     ); // можно добавить обработчик ошибок

    return ERR_OK;
}

/**
 * @brief Initialize HTTP server
 */

void http_server_init(void)
{

    // Create TCP PCB

    struct tcp_pcb *http_pcb;

    http_pcb = tcp_new();
    // http_pcb_bkp = http_pcb;

    if (http_pcb == NULL)
    {
        return; // Failed to create PCB
    }

    // Bind to port 80
    err_t err = tcp_bind(http_pcb, IP_ADDR_ANY, HTTP_PORT);
    if (err != ERR_OK)
    {
        tcp_close(http_pcb);
        return;
    }

    // Start listening
    http_pcb = tcp_listen(http_pcb);
    if (!http_pcb)
    {
        return;
    }

    // Set accept callback
    tcp_accept(http_pcb, http_accept);
}